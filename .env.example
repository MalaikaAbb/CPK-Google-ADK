# CopilotKit + Google ADK test suite — environment
#
# There are TWO processes here, so there are two places these go:
#
#   backend/.env         read by the Python agent server (uv run reads it)
#   frontend/.env.local  read by Next.js at startup
#
# Copy the relevant block into each. Never commit the filled-in files.


# ── backend/.env — required ──────────────────────────────────────────────────

# Google Gemini API key. Every agent runs on gemini-2.5-flash, the one model
# the Quickstart names. Get one at https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_google_api_key


# ── backend/.env — optional ──────────────────────────────────────────────────

# Where the agent server listens. The frontend's default AGENT_URL assumes
# both of these, so change them together or not at all.
# AGENT_HOST=localhost
# AGENT_PORT=8000

# Uvicorn/ADK log level.
# LOG_LEVEL=INFO

# Proxy base URL for Gemini. Only the Sub-Agents route reads this — its
# sub-agent calls go through google.genai directly rather than through ADK.
# GOOGLE_GEMINI_BASE_URL=


# ── frontend/.env.local — optional ───────────────────────────────────────────

# Where the Next runtime forwards agent runs. Defaults to http://localhost:8000.
# Set it if the agent server is on another host, port, or container.
# AGENT_URL=http://localhost:8000

# ── frontend/.env.local — CopilotKit Intelligence ────────────────────────────
#
# Two separate credentials that fail in different ways. Neither is needed to
# chat: without them the runtime falls back to SSE with an in-memory runner and
# every chat route still works — only the three Rich Threads routes go quiet.

# Puts the runtime in Intelligence mode. This is what makes threads persist and
# the thread endpoints return real rows. Server-side only — never prefix it
# with NEXT_PUBLIC_, or the project key ships in the browser bundle.
# Get one at https://dashboard.operations.copilotkit.ai/
# INTELLIGENCE_API_KEY=

# Advertises a licence. /info reports `licenseStatus` from this, and client-side
# feature UIs read that field — <CopilotThreadsDrawer> renders its locked
# "Upgrade" view unless the status is valid, WHETHER OR NOT threads work. So a
# runtime with only the key above serves threads while every drawer shows an
# Upgrade button. Set both.
# COPILOTKIT_LICENSE_TOKEN=

# The client-side half of the same license axis, and what the Threads Drawer
# doc's own sample passes. Either this or COPILOTKIT_LICENSE_TOKEN unlocks the
# drawer's real UI. Genuinely public, hence the NEXT_PUBLIC_ prefix — unlike
# INTELLIGENCE_API_KEY, which is a server secret and must never be prefixed.
# NEXT_PUBLIC_COPILOTKIT_PUBLIC_LICENSE_KEY=ck_pub_...

# The identity the runtime's `identifyUser` reads, sent as headers by the
# provider. Threads are per-user; change these to watch two thread lists
# diverge in the same browser.
# NEXT_PUBLIC_DEMO_USER_ID=harness-local
# NEXT_PUBLIC_DEMO_USER_NAME=Harness User


# Kill switch for the CopilotKit Inspector. Set to `off` and restart to disable
# it app-wide without editing code. It is otherwise on for localhost only.
# NEXT_PUBLIC_COPILOTKIT_INSPECTOR=off

# OpenAI key, used for exactly one thing: Whisper transcription on the /voice
# route. Gemini answers the chat; the mic does not. Without this key every
# other route works normally, /voice still runs via its sample-audio button,
# and clicking the mic returns a clear error instead of a 500.
# OPENAI_API_KEY=sk-...
